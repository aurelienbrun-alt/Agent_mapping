# Keep the build context small. The real .env (with the API key) is excluded so
# the secret never enters the build; the image ships .env.example (sanitized
# template) instead. data/, config/ and templates/ Excel files ARE needed.
.git/
.venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# Secret local env — never send to the build context. .env.example IS shipped.
.env
.env.local

# Frontend build artifacts (rebuilt inside the image)
webapp/frontend/node_modules/
webapp/frontend/dist/

# Runtime output / caches (regenerated at runtime)
docs/cache/
logs/
output/
reports/
# User-imported frameworks are runtime data (persist via a volume on /app/data/custom)
data/custom/

# Large / irrelevant to the image
*.pptx
.claude/
