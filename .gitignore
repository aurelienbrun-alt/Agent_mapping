# Python
__pycache__/
*.pyc
.venv/

# Secrets & local config — never commit real Azure credentials.
# .env.example is the sanitized template that IS committed.
.env
.env.local
!.env.example

# Claude Code files
.claude/
CLAUDE.md

# Generated PowerPoint decks
*.pptx

# Frontend dependencies
node_modules/

# Run artifacts
logs/*.jsonl
logs/*.log
reports/*.md
# output/*.xlsx are committed on purpose so the workbooks appear in the app on Render
docs/cache/*
!docs/cache/.gitkeep
